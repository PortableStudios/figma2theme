{
  "name": "figma2theme",
  "version": "0.9.3",
  "author": "Darcy Glennen <darcy@portable.com.au>",
  "contributors": [
    "Darcy Glennen <darcy@portable.com.au>",
    "Cam Stark <cam@portable.com.au>",
    "Elly Loel <elly.loel@portable.com.au>"
  ],
  "license": "MIT",
  "main": "lib/src/index.js",
  "bin": {
    "figma2theme": "lib/src/index.js"
  },
  "files": [
    "/lib"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/PortableStudios/figma2theme"
  },
  "scripts": {
    "prepare": "husky install",
    "pre-commit": "lint-staged",
    "pre-push": "concurrently --group pnpm:typecheck pnpm:test",
    "dev": "ts-node ./src/index.ts",
    "prebuild": "rimraf ./lib",
    "build": "tsc -p . && tsc -p tsconfig.stories.json",
    "postbuild": "rimraf ./lib/theme && copyfiles ./templates/**/** ./lib",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:coverage:open": "jest --coverage && open ./coverage/lcov-report/index.html",
    "lint": "eslint . --fix --ext .js,.jsx,.ts,.tsx",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.storybook.json",
    "verify": "concurrently --group pnpm:test pnpm:lint pnpm:typecheck",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test-storybook": "test-storybook",
    "global:install": "pnpm build && pnpm add --global file:$PWD",
    "global:remove": "pnpm remove --global figma2theme"
  },
  "dependencies": {
    "@types/ejs": "^3.1.5",
    "@types/fs-extra": "^9.0.13",
    "@types/node-fetch": "^2.6.13",
    "@types/prettier": "^2.7.3",
    "@types/svgo": "^2.6.4",
    "colorjs.io": "0.4.1-patch.1",
    "colors": "^1.4.0",
    "commander": "^9.5.0",
    "date-fns": "^2.30.0",
    "dotenv": "^16.6.1",
    "ejs": "^3.1.10",
    "figma-api": "1.7.0",
    "fs-extra": "^10.1.0",
    "lodash": "^4.18.1",
    "node-fetch": "^2.7.0",
    "polished": "^4.3.1",
    "prettier": "^2.8.8",
    "prompts": "^2.4.2",
    "style-dictionary": "^3.9.2",
    "svg-to-jsx": "^1.0.4",
    "svgo": "^2.8.4",
    "svgson": "^5.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@chakra-ui/icon": "^3.2.0",
    "@chakra-ui/react": "^2.10.10",
    "@chakra-ui/theme-tools": "^2.2.6",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@storybook/addon-designs": "^12.0.0",
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/addon-links": "^10.6.5",
    "@storybook/react-vite": "^10.6.5",
    "@storybook/test-runner": "^0.26.0",
    "@types/flat": "^5.0.5",
    "@types/jest": "^29.5.14",
    "@types/lodash": "^4.17.27",
    "@types/node": "^22.20.5",
    "@types/prompts": "^2.4.9",
    "@types/react": "^18.3.31",
    "@types/rimraf": "^3.0.2",
    "@types/uuid": "^8.3.4",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "babel-jest": "^29.7.0",
    "concurrently": "^7.6.0",
    "copyfiles": "^2.4.1",
    "eslint": "^8.57.1",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-airbnb-typescript": "^17.1.0",
    "eslint-config-prettier": "^8.10.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^4.2.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "flat": "^5.0.2",
    "framer-motion": "^7.10.3",
    "http-server": "^14.1.1",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "lint-staged": "^17.6.0",
    "playwright": "1.64.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-is": "^18.3.1",
    "rimraf": "^3.0.2",
    "storybook": "^10.6.5",
    "tailwindcss": "^3.4.19",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3",
    "uuid": "^11.1.1",
    "vite": "^8.3.5",
    "wait-on": "^9.5.1"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.28.9"
}
